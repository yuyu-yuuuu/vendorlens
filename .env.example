# Run python3 scripts/setup_local_env.py to generate local secrets without printing them.
VENDORLENS_POSTGRES_PASSWORD=
VENDORLENS_REDIS_PASSWORD=
VENDORLENS_API_ACCESS_KEY=
# Local Python processes use loopback; Compose overrides these with container addresses.
VENDORLENS_DATABASE_URL=postgresql+psycopg://vendorlens:${VENDORLENS_POSTGRES_PASSWORD}@127.0.0.1:5433/vendorlens
VENDORLENS_REDIS_URL=redis://:${VENDORLENS_REDIS_PASSWORD}@127.0.0.1:6380/0
VENDORLENS_CHROMA_URL=http://127.0.0.1:8100
VENDORLENS_STORAGE_ROOT=data/files
VENDORLENS_ENVIRONMENT=development
VENDORLENS_MODEL_PROVIDER=openai_compatible
VENDORLENS_MODEL_BASE_URL=https://api.openai.com/v1
VENDORLENS_MODEL_API_KEY=
VENDORLENS_MODEL_NAME=
VENDORLENS_MODEL_TIMEOUT_SECONDS=60
VENDORLENS_MODEL_MAX_TOOL_ROUNDS=4

# 仅 development 可留空；其他环境未配置密钥时业务接口返回 503。
VENDORLENS_UPLOAD_MAX_BYTES=20971520
VENDORLENS_TASK_LEASE_SECONDS=300
# hash 默认离线；local 只读取已下载到本地的模型目录，不自动下载。
VENDORLENS_EMBEDDING_PROVIDER=hash
# VENDORLENS_EMBEDDING_MODEL_PATH=/models/chinese-embedding
# VENDORLENS_RERANKER_MODEL_PATH=/models/reranker
# 两项单价都配置并且模型报告完整 usage 时才计算估算；此处不填市场价格。
# VENDORLENS_MODEL_INPUT_PRICE_PER_MILLION=2
# VENDORLENS_MODEL_OUTPUT_PRICE_PER_MILLION=8
VENDORLENS_MODEL_PRICE_CURRENCY=USD

# 对话工作记忆与情景检索。关闭时使用数据库最近消息和本地混合检索。
VENDORLENS_MEMORY_REDIS_ENABLED=false
VENDORLENS_MEMORY_CHROMA_ENABLED=false
VENDORLENS_MEMORY_TTL_SECONDS=86400
VENDORLENS_MEMORY_RECENT_MESSAGES=6
VENDORLENS_MEMORY_COMPRESS_AT=16
VENDORLENS_SKILLS_ROOT=skills

# 使用现有 MODEL_* 配置即可运行单端点模式。多个兼容端点用 JSON 数组配置。
# VENDORLENS_MODEL_ENDPOINTS=[{"id":"primary","base_url":"https://example.invalid/v1","api_key":"replace-locally","model":"model-name","base_score":100},{"id":"backup","base_url":"https://backup.invalid/v1","api_key":"replace-locally","model":"model-name","base_score":95}]
VENDORLENS_ROUTING_WINDOW_SECONDS=900
VENDORLENS_ROUTING_MIN_SAMPLES=3
VENDORLENS_ROUTING_COOLDOWN_SECONDS=60
VENDORLENS_ROUTING_PROBE_SECONDS=120
VENDORLENS_ROUTING_LATENCY_TARGET_MS=5000
